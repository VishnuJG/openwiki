    {
      "id": "claim_e18c960445ae49b49d97181847b5fd4f",
      "statement": "src/database.py is an independent psycopg2 helper rather than an active-app persistence layer: its Database constructor opens a connection and cursor using passed credentials with defaults 127.0.0.1:5432 and stocksdb2, execute_query runs and commits SQL, fetch_all fetches the current cursor result, and close closes the cursor and connection; app.py and login.py do not import or call it.",
      "evidence": [
        {
          "resource": "repo://src/app.py#L1-L7",
          "version": "repo-lines-v1:sha256:b30489038d463741a7b7786783c6d44f9ae2fed2f65bf12f5f8089450cddf93d:"
